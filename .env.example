# mock = simulated protocol (default). chain = real contract reads via src/protocol/chainAdapter.ts
VITE_DATA_SOURCE=mock

# Robinhood Chain (id 4663). Required when VITE_DATA_SOURCE=chain.
VITE_RPC_URL=https://robinhood-rpc.publicnode.com
VITE_CHAIN_ID=4663

# ── Protocol addresses ───────────────────────────────────────────────────────
# Written by the deploy script to contracts/deployments/<network>.json. Every
# one of these must be set before VITE_DATA_SOURCE=chain will do anything; the
# adapter says which are missing rather than failing obscurely.
VITE_ADDR_MOASS=
VITE_ADDR_SMOASS=
VITE_ADDR_STAKING=
VITE_ADDR_DISTRIBUTOR=
VITE_ADDR_TREASURY=
VITE_ADDR_BOND_DEPOSITORY=
VITE_ADDR_ORACLE=
VITE_ADDR_GME_DESK=
VITE_ADDR_INVERSE_BOND=
# The MOASS/GME canonical pair, a Uniswap V2 pair created at launch.
VITE_ADDR_PAIR=

# ── External addresses (already live on Robinhood Chain) ─────────────────────
# Tokenised GME: "GameStop • Robinhood Token", 18 decimals. The reserve asset.
VITE_ADDR_GME=0x1b0E319c6A659F002271B69dB8A7df2F911c153E
# USDG, 6 decimals. Used only to price GME for display.
VITE_ADDR_USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# GME/USDG Uniswap **V3** pool at the 1% fee tier — the deep GME market on this
# chain is V3, not V2. This is the only source of dollars in the whole app.
VITE_ADDR_GME_USDG_POOL=0xE9713f453aDB9245B19559790c96F470a18F2fDF

# ── Optional ─────────────────────────────────────────────────────────────────
# Where the indexer publishes chart history. Defaults to /history.json, which is
# what the GitHub Action commits.
VITE_HISTORY_URL=
# Free project id from https://cloud.reown.com. Without it, injected browser
# wallets still work and mobile wallets simply do not appear.
VITE_WALLETCONNECT_PROJECT_ID=

# ── Deployment (never expose in the browser) ─────────────────────────────────
# The account that runs `npm run deploy`. It must be the ONLY account used:
# every wire() call is locked to whoever created the contract and can be called
# exactly once, so a deployment cannot be resumed or split across keys.
DEPLOYER_PRIVATE_KEY=
# Multisig that may register taxed AMM pairs and queue tax exemptions.
# Defaults to the deployer if unset, which is fine for testnet only.
GUARDIAN=
# Multisig that holds pTEAM and operates the GME desk.
TEAM_WALLET=
# Where the desk may send GME to run the position. This set is IMMUTABLE after
# deployment. Defaults to TEAM_WALLET, i.e. the multisig executes it directly.
DESK_VENUE=

# ── Indexer only (never expose in the browser) ───────────────────────────────
# Funds the hourly oracle checkpoint. Without something calling checkpoint() at
# least every 4 hours the TWAP falls out of band, emissions mint zero and bonds
# stop pricing. Needs gas and nothing else — it can hold no other value.
INDEXER_PRIVATE_KEY=
